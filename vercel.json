{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/home", "dest": "/index.html" },
    { "src": "/about", "dest": "/about-twibc.html" },
    { "src": "/programs", "dest": "/academic-programs.html" },
    { "src": "/admissions", "dest": "/admissions.html" },
    { "src": "/registration", "status": 308, "headers": { "Location": "https://script.google.com/macros/s/AKfycbxngQKADQCYrls8No6c5otLfRSIMIz-qdqlroCDNl7NEVX7p8Hzqbaz4k1Fyq3mvb4S/exec?page=registration" } },
    { "src": "/campuses", "dest": "/campuses.html" },
    { "src": "/student-life", "dest": "/student-life.html" },
    { "src": "/alumni", "dest": "/alumni.html" },
    { "src": "/contact", "dest": "/contact-us.html" },
    { "src": "/student-portal", "status": 308, "headers": { "Location": "https://script.google.com/macros/s/AKfycbxngQKADQCYrls8No6c5otLfRSIMIz-qdqlroCDNl7NEVX7p8Hzqbaz4k1Fyq3mvb4S/exec?page=portal" } },
    { "src": "/instructor-portal", "status": 308, "headers": { "Location": "https://script.google.com/macros/s/AKfycbxngQKADQCYrls8No6c5otLfRSIMIz-qdqlroCDNl7NEVX7p8Hzqbaz4k1Fyq3mvb4S/exec?page=instructor" } },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}